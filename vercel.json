{
  "version": 2,
  "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/scheduled-transactions/process",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/summary/today",
      "schedule": "0 21 * * *"
    }
  ]
}
